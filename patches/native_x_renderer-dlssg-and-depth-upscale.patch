+bool FrameGeneration::ParseProvider(std::string_view value, Provider& out) {
+  if (value.empty() || EqualsIgnoreCase(value, "auto")) {
+    out = Provider::kAuto;
+    return true;
+  }
+  if (EqualsIgnoreCase(value, "nvidia") || EqualsIgnoreCase(value, "dlssg") || EqualsIgnoreCase(value, "dlss")) {
+    out = Provider::kNvidia;
+    return true;
+  }
+  if (EqualsIgnoreCase(value, "amd") || EqualsIgnoreCase(value, "fsr3") || EqualsIgnoreCase(value, "fsr")) {
+    out = Provider::kAmd;
+    return true;
+  }
+  return false;
+}
