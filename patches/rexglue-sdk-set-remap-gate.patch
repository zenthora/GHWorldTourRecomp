+namespace rex::input {
+
+namespace {
+
+// The game's gate of gamepad_remap (SetRemapGate): the layout applies only while it returns true.
+std::atomic<bool (*)()> g_remap_gate{nullptr};
+
+bool RemapGateOpen() {
+  bool (*gate)() = g_remap_gate.load(std::memory_order_acquire);
+  return !gate || gate();
+}
+
+}  // namespace
+
+void SetRemapGate(bool (*gate)()) {
+  g_remap_gate.store(gate, std::memory_order_release);
+}
+
+}  // namespace rex::input
